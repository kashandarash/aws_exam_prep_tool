{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <div class="text-center mb-5">
        <h1 class="display-4">AWS Developer Associate Exam Prep Tool</h1>
        <p class="lead">Build a question bank for the AWS Certified Developer Associate (DVA-C02) exam from real exam pages, and practice against it.</p>
        <p class="text-muted mb-0">{{ questionCount }} question{{ questionCount == 1 ? '' : 's' }} in the bank &middot; visit #{{ visitCount }} recorded</p>
    </div>

    <h2 class="h4 mb-3">How it works</h2>
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5 card-title">1. Import</h3>
                    <p class="card-text">
                        On the <a href="{{ path('question_add') }}">Add Question</a> page, paste the HTML
                        of an exam question page. It's sent to the Bedrock API, which reads the page and
                        extracts every question, its options, and the correct answer(s) &mdash; wording is
                        copied exactly as written, and anything already in the bank is skipped.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5 card-title">2. Review</h3>
                    <p class="card-text">
                        The <a href="{{ path('question_list') }}">Questions</a> page lists everything that's
                        been imported so far. Open any question to fix a typo or correct an answer on its
                        <a href="{{ path('question_list') }}">edit page</a>.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5 card-title">3. Practice</h3>
                    <p class="card-text">
                        <a href="{{ path('test_take') }}">Take Test</a> pulls up to 10 random questions from
                        the bank, lets you answer them, and then scores you against the correct answer(s)
                        for each one.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h4 mb-3">Where the questions come from</h2>
    <ul class="list-group mb-4">
        <li class="list-group-item">90 questions imported from <a href="https://www.examtopics.com/exams/amazon/aws-certified-developer-associate/" target="_blank" rel="noopener">ExamTopics&rsquo; AWS Certified Developer Associate exam page</a>.</li>
        <li class="list-group-item">10 questions from AWS&rsquo;s official DVA-C02 sample question document.</li>
        <li class="list-group-item">70 questions generated by Claude Code from AWS certification knowledge, each checked against AWS documentation before being added.</li>
    </ul>
{% endblock %}
