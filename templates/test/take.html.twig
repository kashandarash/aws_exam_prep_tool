{% extends 'base.html.twig' %}

{% block title %}Take Test{% endblock %}

{% block body %}
    <h1 class="mb-4">Take Test</h1>

    {% if questions is empty %}
        {% if hasQuestions %}
            <p>Every question has already been answered correctly {{ constant('App\\Entity\\Question::MASTERY_THRESHOLD') }}+ times, so there's nothing left to practice. Check the <a href="{{ path('question_list') }}">Questions</a> page to review them.</p>
        {% else %}
            <p>There are no questions yet. <a href="{{ path('question_add') }}">Add a question</a> to start a test.</p>
        {% endif %}
    {% else %}
        <form method="post" action="{{ path('test_take') }}">
            {% for question in questions %}
                <input type="hidden" name="question_ids[]" value="{{ question.id }}">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>
                            <strong>Question {{ loop.index }}</strong>
                            {% if question.isMultiAnswer %}
                                <span class="badge text-bg-info ms-2">Choose {{ question.correctIndexes|length }}</span>
                            {% endif %}
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="card-text">{{ question.text|nl2br }}</p>
                        <ul class="list-group list-group-flush">
                            {% for index, option in question.options %}
                                <li class="list-group-item">
                                    <div class="form-check">
                                        <input class="form-check-input" type="{{ question.isMultiAnswer ? 'checkbox' : 'radio' }}" name="answers[{{ question.id }}][]" id="q{{ question.id }}_{{ index }}" value="{{ index }}">
                                        <label class="form-check-label" for="q{{ question.id }}_{{ index }}">{{ option.text }}</label>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endfor %}
            <button type="submit" class="btn btn-primary">Submit Test</button>
        </form>
    {% endif %}
{% endblock %}
