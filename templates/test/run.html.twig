{% extends 'base.html.twig' %}

{% block title %}Run Test{% endblock %}

{% block body %}
    <h1 class="mb-4">Run Test</h1>

    {% if questions is empty %}
        <p>There are no questions yet. <a href="{{ path('question_add') }}">Add a question</a> to start a test.</p>
    {% else %}
        <form method="post" action="{{ path('test_run') }}">
            {% for question in questions %}
                <input type="hidden" name="question_ids[]" value="{{ question.id }}">
                <fieldset class="mb-4">
                    <legend class="h5">{{ loop.index }}. {{ question.text }}</legend>
                    {% if question.isMultiAnswer %}
                        <p class="form-text mt-0">Select {{ question.correctIndexes|length }} answers.</p>
                    {% endif %}
                    {% for index, option in question.options %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="answers[{{ question.id }}][]" id="q{{ question.id }}_{{ index }}" value="{{ index }}">
                            <label class="form-check-label" for="q{{ question.id }}_{{ index }}">{{ option.text }}</label>
                        </div>
                    {% endfor %}
                </fieldset>
            {% endfor %}
            <button type="submit" class="btn btn-primary">Submit Test</button>
        </form>
    {% endif %}
{% endblock %}
