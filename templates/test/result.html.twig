{% extends 'base.html.twig' %}

{% block title %}Test Results{% endblock %}

{% block body %}
    <h1 class="mb-4">Test Results</h1>
    <p class="lead">You scored {{ correct }} out of {{ total }}.</p>

    {% for result in results %}
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <strong>Question {{ loop.index }}</strong>
                    {% if result.question.isMultiAnswer %}
                        <span class="badge text-bg-info ms-2">Choose {{ result.question.correctIndexes|length }}</span>
                    {% endif %}
                </span>
                <span class="badge {{ result.isCorrect ? 'text-bg-success' : 'text-bg-danger' }}">{{ result.isCorrect ? 'Correct' : 'Incorrect' }}</span>
            </div>
            <div class="card-body">
                <p class="card-text">{{ result.question.text|nl2br }}</p>
                <ul class="list-group list-group-flush">
                    {% for index, option in result.question.options %}
                        <li class="list-group-item d-flex justify-content-between align-items-center{{ option.correct ? ' list-group-item-success' : (index in result.submittedIndexes ? ' list-group-item-danger' : '') }}">
                            <span>
                                {% if option.correct %}
                                    <span class="me-2 text-success" aria-hidden="true">&#10003;</span>
                                {% endif %}
                                {{ option.text|nl2br }}
                            </span>
                            {% if index in result.submittedIndexes %}
                                <span class="badge text-bg-secondary ms-2">Your answer</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                {% if result.submittedIndexes is empty %}
                    <p class="card-text text-muted mt-2 mb-0">You didn't answer this question.</p>
                {% endif %}
                <div class="mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm explain-btn" data-question-id="{{ result.question.id }}">Explain</button>
                    <div class="alert alert-secondary explain-output mt-2 mb-0" hidden></div>
                </div>
            </div>
        </div>
    {% endfor %}

    <a href="{{ path('test_take') }}" class="btn btn-primary">Take Another Test</a>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('.explain-btn').forEach((button) => {
            button.addEventListener('click', () => {
                const output = button.nextElementSibling;

                button.disabled = true;
                button.textContent = 'Explaining…';
                output.hidden = false;
                output.classList.remove('alert-danger');
                output.classList.add('alert-secondary');
                output.textContent = 'Asking Bedrock for an explanation…';

                fetch('/questions/' + button.dataset.questionId + '/explain', {
                    method: 'POST',
                    headers: {'Accept': 'application/json'},
                })
                    .then((response) => response.json().then((data) => ({ok: response.ok, data: data})))
                    .then(({ok, data}) => {
                        if (!ok || data.error) {
                            throw new Error(data.error || 'Something went wrong.');
                        }

                        output.textContent = data.explanation;
                        button.remove();
                    })
                    .catch((error) => {
                        output.classList.remove('alert-secondary');
                        output.classList.add('alert-danger');
                        output.textContent = error.message;
                        button.disabled = false;
                        button.textContent = 'Explain';
                    });
            });
        });
    </script>
{% endblock %}
