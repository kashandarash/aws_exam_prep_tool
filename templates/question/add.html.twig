{% extends 'base.html.twig' %}

{% block title %}Add Questions{% endblock %}

{% block body %}
    {% if bedrockConnected %}
        <span class="badge text-bg-success mb-3">Bedrock API: Connected</span>
    {% else %}
        <span class="badge text-bg-danger mb-3">Bedrock API: Unavailable</span>
    {% endif %}

    <h1 class="mb-4">Add Questions</h1>
    <p class="form-text">
        Paste the HTML of an exam question page below (see <code>data/input_example.html</code>
        for the kind of page this expects). It's sent to the Bedrock API, which extracts the
        questions, their options, and the correct answer(s), and adds any that aren't already
        in the bank — nothing here is added or changed by hand.
    </p>

    <form method="post" action="{{ path('question_add') }}">
        <div class="mb-3">
            <label for="html" class="form-label">Exam page HTML</label>
            <textarea class="form-control" id="html" name="html" rows="16" placeholder="Paste the full page HTML here&hellip;" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Import Questions</button>
    </form>
{% endblock %}
